# Graph Series backend: environment for docker-compose.yml and the FastAPI app.
# Copy to .env and fill in real values. .env is git-ignored; never commit it.
# Every name here is read by docker-compose.yml or by fastapi/app (see docs/deployment.md).

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_random_password_of_16_or_more_characters

# Qdrant lives on the web server, reached over the private network (gRPC only).
# QDRANT_TAILSCALE_HOST is the address of that server (`tailscale ip -4` there);
# docker-compose.yml passes it to the app as QDRANT_HOST.
QDRANT_TAILSCALE_HOST=<private-network-address-of-the-web-server>
QDRANT_COLLECTION=graph-series
QDRANT_GRPC_PORT=6334

# Embedding service (POST /embed) that turns a query into a vector.
# The default only works when the service runs on the Docker host at port 8004.
EMBED_SERVICE_URL=http://<web-server-private-address>:8004/embed

# Origins allowed by CORS, comma separated (the origin of the site that calls the API).
CORS_ORIGINS_RAW=https://<your-site-domain>

# APP_ENV=production hides the interactive /docs page; any other value shows it.
# APP_ENV=production

# Address of this host on the private network (for example the output of `tailscale ip -4`).
# docker-compose.yml publishes Neo4j (7687) and the API (8000) on it only, and refuses to start while it is unset.
PRIVATE_BIND_IP=<private-network-address-of-this-host>
